# OPCJONALNE. Zwykle nic tu nie trzeba — hasło i klucze API ustawia kreator w przeglądarce (/setup),
# a później Menu → Narzędzia. Plik .env przydaje się do automatycznych instalacji.
# Wartość ustawiona tutaj ma pierwszeństwo i nie da się jej zmienić z poziomu apki.
# Użycie: cp .env.example .env && chmod 600 .env, odkomentuj env_file w docker-compose.yml.

# Hasło i klucz sesji (bez nich: kreator ustawi hasło, klucz sesji wygeneruje się sam)
# APP_PASSWORD=
# klucz sesji wygenerujesz: openssl rand -hex 32
# SECRET_KEY=

# IGDB (dane o grach, obrazy konsol) — klucze z dev.twitch.tv/console
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# eBay (sugerowana cena) — darmowe klucze produkcyjne z developer.ebay.com (Application Keys → Production)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# rynki do porównania (domyślnie Niemcy, UK, Polska)
# EBAY_MARKETS=EBAY_DE,EBAY_GB,EBAY_PL

# ScreenScraper (okładki per region) — konto na screenscraper.fr + klucze deweloperskie z forum
# SS_DEVID=
# SS_DEVPASSWORD=
# SS_USER=
# SS_PASSWORD=

# LaunchBox (zapasowe okładki) — 0 wyłącza automatyczne pobranie bazy przy starcie
# LAUNCHBOX_AUTO_IMPORT=1

# Backup automatyczny (domyślnie 3:00, 14 kopii w /data/backups)
# BACKUP_HOUR=3
# BACKUP_KEEP=14
# kopia na drugi dysk — katalog podmontowany do kontenera (volumes w docker-compose.yml)
# BACKUP_COPY_DIR=

# HTTPS w sieci domowej (port 8443, lokalny certyfikat — potrzebny m.in. do aparatu w telefonie)
# adresy do certyfikatu, np. 192.168.1.20,gry.lan — apka dopisuje też sama adres, pod którym ją otwierasz
# TLS_HOSTS=
# HTTPS_PORT=0 wyłącza HTTPS
# HTTPS_PORT=8443
